<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/nestedScrollView">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rootConstraintLayout">

        <ImageView
            android:id="@+id/artifactImage"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.392"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <TextView
            android:id="@+id/artifactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="20dp"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/artifactImage" />

        <TextView
            android:id="@+id/artifactCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/artifactName" />

        <TextView
            android:id="@+id/artifactMaterial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/artifactCategory" />

        <TextView
            android:id="@+id/artifactDynastyPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="1dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/artifactMaterial" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/editArtifactButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="150dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="-30dp"
            android:text="EDIT"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/artifactCategory"
            app:layout_constraintTop_toBottomOf="@+id/artifactName" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteArtifactButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="150dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="-30dp"
            android:text="DELETE"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/artifactCategory"
            app:layout_constraintTop_toBottomOf="@+id/editArtifactButton"/>

        <LinearLayout
            android:id="@+id/counts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/artifactDynastyPeriod">

            <CheckBox
                android:id="@+id/likesButtonAndCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:button="@drawable/favorite_selector"
                android:paddingStart="3dp"
                android:paddingEnd="5dp"
                android:drawablePadding="8dp"/>

            <CheckBox
                android:id="@+id/savesButtonAndCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="3dp"
                android:paddingEnd="5dp"
                android:button="@drawable/toggle_saved"/>

            <Button
                android:id="@+id/commentsButtonAndCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#00FFFFFF"
                android:drawableLeft="@drawable/ic_comment"
                android:gravity="center|start|left"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <!-- ===================== DESCRIPTION SECTION ===================== -->

        <TextView
            android:id="@+id/descriptionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="24dp"
            android:text="Description"
            android:textSize="18sp"
            android:textStyle="bold|italic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/counts" />

        <TextView
            android:id="@+id/descriptionText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="30dp"
            android:ellipsize="end"
            android:lineSpacingExtra="4dp"
            android:maxLines="4"
            android:text="A Walk in the Park\nPeople go to the local park for fresh air. Some walk fast on the dirt path. Others sit on wooden benches to read books. Children run and play on the green grass.\nThe Value of Reading\nReading books helps people learn new things. Every page opens a door to a different world. Stories teach us about other places and people. Knowledge grows stronger with each new book we finish.\nEvening Calm\nThe day ends as the sky turns orange and pink. Shadows stretch long across the ground. Lights turn on in the cozy houses. Night brings a deep and peaceful calm."
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/descriptionHeader" />

        <TextView
            android:id="@+id/viewMoreButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="6dp"
            android:padding="4dp"
            android:text="View more"
            android:textStyle="bold"
            android:textColor="@color/primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/descriptionText" />

        <!-- ===================== METADATA SECTION ===================== -->
        <TextView
            android:id="@+id/artifactMetadata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="18dp"
            android:text="Artifact Metadata"
            android:textSize="16sp"
            android:textStyle="bold|italic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/viewMoreButton" />

        <TextView
            android:id="@+id/artifactCulturalOrigin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:text="Cultural Origin"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/artifactMetadata" />
        <TextView
            android:id="@+id/artifactDimensions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Dimensions"
            app:layout_constraintTop_toBottomOf="@id/artifactCulturalOrigin"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="30dp"/>
        <TextView
            android:id="@+id/artifactConditionReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Condition Report"
            app:layout_constraintTop_toBottomOf="@id/artifactDimensions"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="30dp"/>
        <TextView
            android:id="@+id/artifactCurrentLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Current Location"
            app:layout_constraintTop_toBottomOf="@id/artifactConditionReport"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="30dp"/>
        <TextView
            android:id="@+id/artifactAcquisitionMethod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Acquisition Method"
            app:layout_constraintTop_toBottomOf="@id/artifactCurrentLocation"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="30dp"/>
        <TextView
            android:id="@+id/artifactProvenance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Provenance"
            app:layout_constraintTop_toBottomOf="@id/artifactAcquisitionMethod"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="30dp"/>
        <TextView
            android:id="@+id/artifactAccesionNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Accesion Number"
            app:layout_constraintTop_toBottomOf="@id/artifactProvenance"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="30dp"/>
        <TextView
            android:id="@+id/artifactNotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="Notes"
            app:layout_constraintTop_toBottomOf="@id/artifactAccesionNumber"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="30dp"/>

        <!-- ===================== COMMENTS SECTION ===================== -->

        <View
            android:id="@+id/commentsDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="20dp"
            android:background="@color/text_secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/artifactNotes" />

        <TextView
            android:id="@+id/commentsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="16dp"
            android:text="Comments"
            android:textSize="18sp"
            android:textStyle="bold|italic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/commentsDivider" />

        <LinearLayout
            android:id="@+id/inputCommentSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/commentsHeader">

            <EditText
                android:id="@+id/commentEditText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:ems="10"
                android:gravity="left|bottom"
                android:hint="Have something to say?"
                android:inputType="textMultiLine"
                android:textSize="14sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitCommentButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                app:backgroundTint="@color/primary"
                android:text="Comment"
                android:layout_gravity="center"
                app:cornerRadius="50dp"
                android:textSize="14sp"/>

        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@+id/inputCommentSection" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>